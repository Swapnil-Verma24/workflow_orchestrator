# Gitignore for SagePilot Project

# Python artifacts
**/__pycache__/
**/*.py[cod]
*$py.class
**/.venv/
**/env/
**/venv/
**/ENV/

# Large Binaries & Project binaries
*.exe
*.dll
*.so
*.bin
*.msi
sagepilot/temporal.zip
sagepilot/temporal-cli/

# Build artifacts
**/build/
**/dist/
**/*.egg-info/
**/.next/
**/out/

# Node.js
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases
backend/workflows.db
*.sqlite
*.db
*.db-journal

# Environment and Secrets
.env
.env.production
.env.local
.env.*.local
.flaskenv
secrets.json
*.pem
*.key

# IDEs
.vscode/
.idea/
*.swp
*.swo

# System
.DS_Store
Thumbs.db
Desktop.ini

# Scratchpad / Test Scripts / Logs
sagepilot/test.py
sagepilot/visualize.py
sagepilot/visualize_payload_flow.py
sagepilot/test_decision_node.py
sagepilot/test_hardening.py
sagepilot/comprehensive_test.py
sagepilot/frontend-simple/
test_advanced_features.py
test_out*.txt
test_workflows_tmp.db
debug.log
error.log
