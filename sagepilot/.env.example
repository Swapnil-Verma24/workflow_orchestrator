# 🔧 Local Development Configuration
# This file is set up for LOCAL DEVELOPMENT with separate services
# For deployment configuration, see DEPLOYMENT.md

# Backend Configuration
PORT=8000
DATABASE_URL=sqlite:///./workflows.db

# Temporal Configuration (Local Development Server)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=workflow-execution-queue

# Worker Mode
# IMPORTANT: Keep this as 'false' for local development
# Set to 'true' only when deploying to production (see DEPLOYMENT.md)
EMBEDDED_WORKER=false  # false = run worker separately (local dev)

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────
# 📝 DEPLOYMENT NOTES:
# 
# For production deployment, you need different values:
# - TEMPORAL_HOST: Your Temporal Cloud address (e.g., namespace.tmprl.cloud:7233)
# - EMBEDDED_WORKER: Set to 'true' to run worker in same process as API
# - VITE_API_URL: Your deployed backend URL (e.g., https://your-app.onrender.com)
#
# See DEPLOYMENT.md for complete deployment instructions
# ─────────────────────────────────────────────────────────
