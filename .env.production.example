# Environment Configuration for Production Deployment
# Copy these values to your hosting platform's environment variables

# Backend Configuration
DATABASE_URL=sqlite:///./workflows.db
# For persistent data, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Temporal Configuration (Temporal Cloud)
TEMPORAL_HOST=<YOUR_NAMESPACE>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=workflow-execution-queue

# CRITICAL: Enable embedded worker for free tier deployments
EMBEDDED_WORKER=true

# Port (usually auto-set by platform)
PORT=8000
